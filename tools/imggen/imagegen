#!/bin/bash
# imagegen "prompt" [concept|pixel] [w] [h] — generate an image on the fleet GPU (Huginn).
# Saves into the Forge ImgGen gallery and prints the view URL. No local GPU needed.
SVC="http://10.2.0.11:8710"
P="${1:?usage: imagegen \"prompt\" [concept|pixel] [width] [height]}"
PROF="${2:-concept}"; W="${3:-1024}"; H="${4:-1024}"
BODY=$(python3 -c 'import json,sys; print(json.dumps({"prompt":sys.argv[1],"profile":sys.argv[2],"width":int(sys.argv[3]),"height":int(sys.argv[4])}))' "$P" "$PROF" "$W" "$H")
echo "generating ($PROF, ${W}x${H})..."
RESP=$(curl -s --max-time 600 -X POST "$SVC/generate" -H "Content-Type: application/json" -d "$BODY")
FILE=$(printf '%s' "$RESP" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("meta",{}).get("file","") or "ERROR: "+str(d.get("error")))')
case "$FILE" in
  ERROR*) echo "$FILE"; exit 1;;
  *) echo "done -> view: $SVC/img/$FILE   (gallery: $SVC/)";;
esac
