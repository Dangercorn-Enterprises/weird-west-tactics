; Engine configuration file.
; Dustfall: The Ashen Frontier — Godot 4 port (HD-2D).
; Design data is generated from ../src/data.js via `node tools/export_data.js`.

config_version=5

[application]

config/name="Dustfall: The Ashen Frontier"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7")

[autoload]

GameState="*res://scripts/game_state.gd"
Audio="*res://scripts/audio.gd"
PauseMenu="*res://scripts/pause_menu.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; v1.4: the HUD is pixel-positioned for 1280x720; without a stretch mode it sat
; in the top-left corner of any larger window. canvas_items scales the 2D layer
; with the window, expand keeps wider aspects from letterboxing the 3D board.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=0
